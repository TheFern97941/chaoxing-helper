{
  "manifest_version": 3,
  "name": "超星学习通自动播放助手",
  "version": "3.7.1",
  "minimum_chrome_version": "116",
  "description": "在侧边栏播放超星课程视频、切换课时，或抓取题目并复制为 JSON。",
  "permissions": [
    "scripting",
    "sidePanel",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": ["*://*.chaoxing.com/*"],
  "action": {
    "default_title": "打开超星学习助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.chaoxing.com/*"],
      "js": ["catalog.js", "player.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
